{
  "entities": {
    "FarmSpecimen": {
      "title": "FarmSpecimen",
      "description": "A saved plant or crop specimen identified by AgriSmart with taxonomic and agronomic care data.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated farmer who owns this specimen record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accessionNumber": {
          "type": "string",
          "description": "Catalog accession identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "commonName": {
          "type": "string",
          "description": "Common name of the crop or plant.",
          "minLength": 1,
          "maxLength": 160
        },
        "scientificName": {
          "type": "string",
          "description": "Binomial scientific name of the crop or plant.",
          "minLength": 1,
          "maxLength": 160
        },
        "family": {
          "type": "string",
          "description": "Botanical family name.",
          "minLength": 1,
          "maxLength": 120
        },
        "locationInFarm": {
          "type": "string",
          "description": "Field plot, greenhouse, or conservatory location.",
          "minLength": 1,
          "maxLength": 160
        },
        "lastWateredDate": {
          "type": "string",
          "description": "ISO date string of last irrigation.",
          "minLength": 4,
          "maxLength": 32
        },
        "nextWateringDueDays": {
          "type": "integer",
          "description": "Days remaining until next scheduled irrigation."
        },
        "overallHealth": {
          "type": "string",
          "description": "Summary of plant vitality and pathology inspection.",
          "minLength": 1,
          "maxLength": 200
        },
        "soilPhRange": {
          "type": "string",
          "description": "Target soil pH range.",
          "minLength": 1,
          "maxLength": 80
        },
        "wateringInterval": {
          "type": "string",
          "description": "Recommended watering interval.",
          "minLength": 1,
          "maxLength": 160
        },
        "editorialSummary": {
          "type": "string",
          "description": "Monograph summary of the specimen.",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the specimen was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the specimen was last updated."
        }
      },
      "required": [
        "ownerId",
        "accessionNumber",
        "commonName",
        "scientificName",
        "family",
        "locationInFarm",
        "lastWateredDate",
        "nextWateringDueDays",
        "overallHealth",
        "soilPhRange",
        "wateringInterval",
        "editorialSummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "FieldReport": {
      "title": "FieldReport",
      "description": "A saved GPS meteorological, geological, and planting advisory report for a farmer's coordinates.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated farmer who saved this field report.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "locationName": {
          "type": "string",
          "description": "Region or farm location label.",
          "minLength": 1,
          "maxLength": 160
        },
        "latitude": {
          "type": "number",
          "description": "GPS latitude coordinate."
        },
        "longitude": {
          "type": "number",
          "description": "GPS longitude coordinate."
        },
        "altitudeMeters": {
          "type": "number",
          "description": "Elevation in meters above sea level."
        },
        "estimatedSoilPh": {
          "type": "string",
          "description": "Estimated regional soil pH and geological profile.",
          "minLength": 1,
          "maxLength": 160
        },
        "rainWindow": {
          "type": "string",
          "description": "Expected rain window and precipitation outlook.",
          "minLength": 1,
          "maxLength": 300
        },
        "plantingWindow": {
          "type": "string",
          "description": "Recommended planting timing and crop suitability.",
          "minLength": 1,
          "maxLength": 500
        },
        "advisoryNotes": {
          "type": "string",
          "description": "Detailed agronomic advisory notes.",
          "minLength": 1,
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the report was saved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the report was updated."
        }
      },
      "required": [
        "ownerId",
        "locationName",
        "latitude",
        "longitude",
        "altitudeMeters",
        "estimatedSoilPh",
        "rainWindow",
        "plantingWindow",
        "advisoryNotes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/specimens/{specimenId}": {
      "schema": {
        "$ref": "#/entities/FarmSpecimen"
      },
      "description": "Stores farmer plant specimens, irrigation logs, and care parameters."
    },
    "/fieldReports/{reportId}": {
      "schema": {
        "$ref": "#/entities/FieldReport"
      },
      "description": "Stores saved GPS meteorological, altitude, soil pH, and planting advisory reports."
    }
  }
}
